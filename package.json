    "@uiw/react-codemirror": "^4.25.0", "@codemirror/lang-python": "^6.2.1", "@codemirror/lang-html": "^6.4.9", "@codemirror/theme-one-dark": "^6.1.3", "@codemirror/view": "^6.38.6",
    "idb": "^8.0.3", "lucide-react": "^0.468.0", "zod": "^4.1.0", "helmet": "^8.1.0", "express-rate-limit": "^8.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3", "vite": "^7.2.0", "@vitejs/plugin-react": "^5.1.0", "tsx": "^4.20.6", "esbuild": "^0.25.12", "vitest": "^4.0.0", "supertest": "^7.1.4", "@types/supertest": "^6.0.3", "@types/express": "^5.0.5", "@types/node": "^24.10.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "fake-indexeddb": "^6.2.4"
  }
